  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Archibald Augustus Croak, or Master Augi, according to his young apprentice,
    was at 159 years of age and quite accustomed to his life as a court alchemist.
    \n\nWhen the last monarchy, his Queens\u2019 reign, came to a sudden end brought
    about by the neo-feudalist power shift into a corporate oligarchy, he was left
    with half a day to gather all of his life\u2019s collected belongings that he
    could fit into suitcases before he was summarily kicked out of the herbology
    wing of the castle gardens, leaving him with nothing to his name save what he
    could lug along in his baggage.\n\r\nAfter ordering a ride from Broomer, a Witches
    Inc. subsidiary, he was dropped off in the city proper. He had seen to a place
    to live, at least. One of his prior students had made quite the name for themselves
    in corporate alchemy working for the regent usurpers, in fact: AlembiCo.\r\n\r\nOut
    of a sense of duty, guilt, or perhaps a combination of the two, his prior student
    arranged for him to take residence in a defunct potion shop that he had taken
    ownership of in his climb of the ladder\u2019s increasing heights.\r\n\r\nNow,
    Archibald Augustus Croak, court alchemist, lives above a potion shop trying to
    scrape by enough money to pay to his landlord, his previous student turned corporate
    alchemist, to keep the roof over his head.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
